{
  "name": "b4um-thor-templates",
  "displayName": "b4um Thor Templates",
  "description": "Syntax highlighting and formatting for Ruby and Rake Thor templates, Ruby files, and Rails ERB views.",
  "icon": "icons/b4um-icon.png",
  "version": "0.2.2",
  "publisher": "b4um",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonsai1972/b4um-thor-templates.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:b4um-thor-erb",
    "onLanguage:b4um-rails-erb",
    "onLanguage:b4um-thor-ruby",
    "onLanguage:ruby"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "b4um-thor-erb",
        "aliases": [
          "b4um Thor ERB",
          "Thor ERB"
        ],
        "extensions": [
          ".html.erb.tt",
          ".erb.tt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "b4um-rails-erb",
        "aliases": [
          "b4um Rails ERB",
          "Rails ERB"
        ],
        "extensions": [
          ".html.erb",
          ".erb"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "b4um-thor-ruby",
        "aliases": [
          "b4um Thor Ruby",
          "Thor Ruby"
        ],
        "extensions": [
          ".rb.tt",
          ".rake.tt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "b4um-thor-javascript",
        "aliases": [
          "b4um Thor JavaScript",
          "Thor JavaScript"
        ],
        "extensions": [
          ".js.tt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "b4um-thor-css",
        "aliases": [
          "b4um Thor CSS",
          "Thor CSS"
        ],
        "extensions": [
          ".css.tt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[b4um-thor-erb]": {
        "editor.defaultFormatter": "b4um.b4um-thor-templates",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[b4um-rails-erb]": {
        "editor.defaultFormatter": "b4um.b4um-thor-templates",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[b4um-thor-ruby]": {
        "editor.defaultFormatter": "b4um.b4um-thor-templates",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "b4um Thor Templates",
      "properties": {
        "b4umThorTemplates.printWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "description": "Bevorzugte Zeilenlänge für die Ruby- und ERB-Formatierung."
        },
        "b4umThorTemplates.rubyExecutablePath": {
          "type": "string",
          "default": "ruby",
          "scope": "machine-overridable",
          "description": "Ruby-Executable mit installierten syntax_tree- und prettier_print-Gems."
        }
      }
    },
    "grammars": [
      {
        "language": "b4um-thor-erb",
        "scopeName": "text.html.erb.thor",
        "path": "./syntaxes/thor-erb.tmLanguage.json"
      },
      {
        "language": "b4um-rails-erb",
        "scopeName": "text.html.erb.thor",
        "path": "./syntaxes/thor-erb.tmLanguage.json"
      },
      {
        "language": "b4um-thor-ruby",
        "scopeName": "source.ruby.thor",
        "path": "./syntaxes/thor-ruby.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@ruby/prism": "^1.9.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
